{
  "name": "natrix",
  "version": "1.0.0",
  "description": "A framework-free, local two-player Snake game.",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "preview": "node scripts/serve-dist.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test-coverage": "jest --coverage --runInBand",
    "verify:dev-server": "node scripts/verify-server.js development",
    "verify:preview": "node scripts/verify-server.js preview"
  },
  "author": "Hsien W Wei",
  "license": "ISC",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "compression-webpack-plugin": "^12.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
